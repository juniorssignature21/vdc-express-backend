{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{.venv/**,.pytest_cache/**,uploads/**,staticfiles/**,*.db,**/__pycache__/**,**/tests.py}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
