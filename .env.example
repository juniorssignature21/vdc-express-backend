# Copy to backend/.env and adjust. All settings use the TP_ prefix.
TP_SECRET_KEY=sFlIz4Bw23$f6ZOX@GCY6VFWUgx1Q_7yxmFHTgvR8ItlA
TP_DEBUG=true
TP_ALLOWED_HOSTS=localhost,127.0.0.1
TP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TP_CSRF_TRUSTED_ORIGINS=https://yourdomain.com   (needed for /django-admin/ behind HTTPS)

# Optional extra CORS origins as regexes, e.g. Vercel previews of the frontend project:
# TP_CORS_ORIGIN_REGEX=^https://trackpro-frontend-[a-z0-9-]+\.vercel\.app$

# Database: a URL wins over everything below (required on Vercel; DATABASE_URL / POSTGRES_URL are also read)
# TP_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Database: SQLite at backend/trackpro.db by default. For Postgres (pip install "psycopg[binary]"):
# TP_DB_ENGINE=postgresql
# TP_DB_NAME=trackpro
# TP_DB_USER=postgres
# TP_DB_PASSWORD=
# TP_DB_HOST=localhost
# TP_DB_PORT=5432

# First admin account – created by `python manage.py seed` when no staff user exists
TP_ADMIN_EMAIL=admin@vdcexpresslogistics.com
TP_ADMIN_PASSWORD=admin123

# Load the three demo shipments on an empty database
TP_SEED_DEMO_DATA=true

# Company details shown across the site and on receipts
TP_COMPANY_NAME=VDC Express Logistics
TP_COMPANY_PHONE=+1 (555) 010-0199
TP_COMPANY_EMAIL=support@vdcexpresslogistics.com
TP_COMPANY_ADDRESS=100 Express Way, Suite 200, Houston, TX 77032, United States
TP_CURRENCY_SYMBOL=$
TP_CURRENCY_CODE=USD
TP_VAT_RATE=0                       # sales tax on shipping charges (0 = none)
TP_TAX_LABEL=Sales tax
TP_FUEL_SURCHARGE=0.18              # fuel surcharge as a share of transport charges; review monthly
TP_BUSINESS_TIME_ZONE=America/Chicago   # daily pickup cut-off (17:00, Same Day 12:00) is in this zone

# Online booking: card-only Flutterwave Standard checkout (dashboard → Settings → API Keys; test keys contain _TEST).
TP_FLUTTERWAVE_SECRET_KEY=
# Dashboard → Settings → Webhooks: URL https://<api-domain>/api/flutterwave/webhook and a secret hash of your
# choosing; put the same secret hash here (Flutterwave sends it back in the verif-hash header).
TP_FLUTTERWAVE_SECRET_HASH=
# Cards are charged in the site currency (USD) by default; USD must be enabled on your Flutterwave account.
# Fallback without USD: charge naira at a fixed rate (naira per $1).
# TP_FLUTTERWAVE_CURRENCY=NGN
# TP_FLUTTERWAVE_FX_RATE=1550
# Name and logo shown on the Flutterwave checkout (instead of the Flutterwave account's business).
# Defaults: TP_COMPANY_NAME and <TP_FRONTEND_URL>/branding/vdc-icon-512.png
# TP_CHECKOUT_TITLE=VDC Express Logistics
# TP_CHECKOUT_LOGO=https://vdcexpresslogistics.com/branding/vdc-icon-512.png
TP_FRONTEND_URL=http://localhost:5173   # customers return here after paying (/book/confirm)

# Photo storage: S3-compatible bucket (required on Vercel). Leave unset to store on local disk.
# TP_S3_BUCKET=trackpro-uploads
# TP_S3_ACCESS_KEY_ID=
# TP_S3_SECRET_ACCESS_KEY=
# TP_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   (omit for AWS S3)
# TP_S3_REGION=auto
# TP_S3_PUBLIC_DOMAIN=pub-xxxx.r2.dev     (public host the bucket is served from)
# TP_S3_SIGNED_URLS=false                 (true for a private bucket: URLs are signed and expire)
# TP_MAX_UPLOAD_MB=8                      (defaults to 4 on Vercel, which caps request bodies at 4.5 MB)

